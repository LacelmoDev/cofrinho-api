# Copia este ficheiro para .env e preenche.
DEBUG=True
SECRET_KEY=muda-isto-para-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
# Deixa vazio para usar SQLite local (db.sqlite3). Em produção: a URL do Neon.
DATABASE_URL=
# Origens do front-end autorizadas (separadas por vírgula). Em DEBUG já aceita localhost e a rede local.
CORS_ALLOWED_ORIGINS=
# Email real (Brevo). Sem chave, o código aparece na consola (e na resposta, só em DEBUG).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Cofrinho AO
